{
  "name": "effect-grammar",
  "version": "0.0.2",
  "description": "Effect Schema, but for text formats: one grammar yields a parser, printer, rendered form, and Schema",
  "keywords": [
    "bidirectional",
    "combinators",
    "effect",
    "grammar",
    "parser",
    "printer",
    "round-trip",
    "schema"
  ],
  "homepage": "https://github.com/saiashirwad/effect-grammar#readme",
  "bugs": {
    "url": "https://github.com/saiashirwad/effect-grammar/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/saiashirwad/effect-grammar.git"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./parser": {
      "types": "./dist/parser.d.ts",
      "import": "./dist/parser.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --dir test",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "prepare": "./scripts/prepare-effect.sh && effect-tsgo patch",
    "prepublishOnly": "pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "effect": "4.0.0-beta.102"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.0",
    "@effect/language-service": "^0.87.1",
    "@effect/tsgo": "0.24.3",
    "@effect/vitest": "4.0.0-beta.102",
    "@types/node": "^26.1.2",
    "oxfmt": "^0.61.0",
    "typescript": "^7.0.2",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@11.17.0+sha512.cca3cea332ad254bb84145f966d19f4879615210346fc92c79a047f23a0d7b3cca3c3792f0076ba1f1831d277efbcf0a9119b31a9a60eca7fb3d6231f331ef72"
}
