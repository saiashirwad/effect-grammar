{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": false,
  "sortPackageJson": {},
  "ignorePatterns": [".repos/**", "tools/oxlint/anti-slop/**", "**/*.gen.ts"],
  "sortImports": {},
  "sortTailwindcss": { "functions": ["cn"] },
  "proseWrap": "always",
  "overrides": [
    {
      "files": ["**/*.md", "**/*.mdx"],
      "options": {
        "printWidth": 80,
      },
    },
  ],
}
